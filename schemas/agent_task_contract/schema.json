{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-math-recommend.dev/schemas/agent_task_contract/v1.0.0/schema.json",
  "title": "Agent Task Contract",
  "description": "AI 数学抽卡系统 · 标准化 Agent 任务契约模式 v1.0.0（设计规范 §11.1 通用模板）。所有流水线 Agent 任务（P1–P6 等）必须以本契约定义；Agent 无权静默发布、覆盖原文或删除证据（§4.5）。",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "task_id",
    "task_name",
    "task_version",
    "purpose",
    "inputs",
    "allowed_sources",
    "allowed_tools",
    "forbidden_actions",
    "procedure",
    "output_schema",
    "evidence_requirements",
    "hard_fail_conditions",
    "soft_fail_conditions",
    "human_review_required_when",
    "quality_checks",
    "retry_policy",
    "logging_requirements"
  ],
  "properties": {
    "task_id": {
      "type": "string",
      "pattern": "^TASK-[0-9]{3}$",
      "description": "任务编号，对应流水线阶段（TASK-101=P1 类）。"
    },
    "task_name": {
      "type": "string",
      "pattern": "^[a-z0-9_]+$",
      "description": "任务机器名。"
    },
    "task_version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "purpose": { "type": "string", "minLength": 1 },
    "inputs": {
      "type": "object",
      "additionalProperties": false,
      "required": ["required", "optional"],
      "properties": {
        "required": { "type": "array", "items": { "type": "string" } },
        "optional": { "type": "array", "items": { "type": "string" } }
      }
    },
    "allowed_sources": {
      "type": "array",
      "items": { "type": "string" },
      "description": "只允许访问已登记数据源（SRC-xxxx 或显式 URL 白名单）。"
    },
    "allowed_tools": {
      "type": "array",
      "items": { "type": "string" },
      "description": "允许使用的工具清单（web_search、embedding_recall、schema_validator 等）。"
    },
    "forbidden_actions": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string" },
      "description": "至少包含：不得覆盖不可变字段、不得静默发布、不得扩大任务范围。"
    },
    "procedure": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string" },
      "description": "有序步骤。"
    },
    "output_schema": {
      "type": "object",
      "additionalProperties": false,
      "required": ["format", "ref"],
      "properties": {
        "format": { "enum": ["json", "yaml"] },
        "ref": {
          "type": "string",
          "description": "输出必须满足的 Schema $id（或 problem_card 的某子结构说明）。"
        }
      }
    },
    "evidence_requirements": {
      "type": "array",
      "items": { "type": "string" },
      "description": "每个关键判断必须绑定的证据种类与数量要求。"
    },
    "hard_fail_conditions": {
      "type": "array",
      "items": { "type": "string" },
      "description": "触发即停止并进入人工/异常队列。"
    },
    "soft_fail_conditions": {
      "type": "array",
      "items": { "type": "string" },
      "description": "触发即降级（unknown / partial）并记录。"
    },
    "human_review_required_when": {
      "type": "array",
      "items": { "type": "string" },
      "description": "必须人工复核的触发条件。"
    },
    "quality_checks": {
      "type": "array",
      "items": { "type": "string" },
      "description": "确定性程序质检（Schema 校验、LaTeX 校验、引用定位检查等）。"
    },
    "retry_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["max_retries", "backoff"],
      "properties": {
        "max_retries": { "type": "integer", "minimum": 0, "maximum": 3 },
        "backoff": { "enum": ["none", "fixed", "exponential"] },
        "notes": { "type": "string" }
      }
    },
    "logging_requirements": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string" },
      "description": "必须记录：模型版本、提示词版本、工具调用、输入证据引用、时间戳（§11.2-10）。"
    }
  }
}
